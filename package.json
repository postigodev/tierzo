{
  "name": "tierzo-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/python.mjs -m uvicorn tierzo_api.main:app --app-dir apps/api --reload --port 8000",
    "dev:web": "corepack pnpm --filter @tierzo/web dev",
    "api:dev": "corepack pnpm dev:api",
    "web:dev": "corepack pnpm dev:web",
    "build": "corepack pnpm --filter @tierzo/web build",
    "lint": "corepack pnpm --filter @tierzo/web lint",
    "test": "node scripts/python.mjs -m unittest discover -s tests",
    "verify": "corepack pnpm test && corepack pnpm lint && corepack pnpm build",
    "demo:verify": "corepack pnpm --filter @tierzo/web verify:demo"
  },
  "dependencies": {
    "lucide-react": "^1.12.0"
  }
}
