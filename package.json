{
  "name": "tierzo-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "api:dev": "python -m uvicorn tierzo_api.main:app --app-dir apps/api --reload --port 8000",
    "demo:verify": "pnpm --filter @tierzo/web verify:demo",
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:lint": "pnpm --dir apps/web lint"
  }
}
